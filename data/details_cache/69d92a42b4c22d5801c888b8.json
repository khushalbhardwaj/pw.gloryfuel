g\" />\n<div class=\"text-container\"><span class=\"sub-text\"> Subjects: Mobile Graphic Designing</span></div>\n</div>\n</div>\n</body>\n</html>","subjects":[{"_id":"69d9e1c55833f0c0586212d8","subject":"Notices","slug":"notices-159542","icon":"https://d2bps9p1kiy4ka.cloudfront.net/5eb393ee95fab7468a79d189/95a17012-9abb-4254-82d9-2b18ce08d9dc.png","lectureCount":2,"subjectId":"69d9e1c55833f0c0586212d8"},{"_id":"69f05538a480d93c97e3ed20","subject":"Graphic Design by Priyanshu Sir","slug":"graphic-design-by-priyanshu-sir-196230","icon":"https://static.pw.live/5eb393ee95fab7468a79d189/ADMIN/c8ce82c0-1f0f-43a0-a653-8b65f2f57fc9.png","lectureCount":12,"subjectId":"69f05538a480d93c97e3ed20"},{"_id":"69ef6140ec6c6572bd9fe6aa","subject":"Graphic Design by Saad Sir","slug":"graphic-design-by-saad-sir-209840","icon":"https://static.pw.live/5eb393ee95fab7468a79d189/ADMIN/7463c78b-11f4-4d7c-a51f-4a0705ab5c60.png","lectureCount":12,"subjectId":"69ef6140ec6c6572bd9fe6aa"}]}}